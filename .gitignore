# Dependências instaladas: reconstroem-se a partir do package-lock.json / pom.xml / *.csproj.
node_modules/

# Saída de build: gerada, nunca escrita à mão.
dist/
build/
target/
bin/
obj/

# Segredos locais. O compose lê JWT_SECRET/WEB_PORT do ambiente; um .env nunca vai para o Git.
.env
.env.*
!.env.example

# Resultados de testes (Playwright) e logs.
test-results/
playwright-report/
blob-report/
*.log
npm-debug.log*

# Editores e sistema operativo.
.vscode/
.idea/
*.swp
.DS_Store

# Capturas de ecrã geradas pela prática de estilos (npm run verificar 09).
pratica/09-estilos-css/capturas/

# Repositórios Git de treino, criados por `npm run git-cenario` (módulo 16). Cada um tem o seu próprio .git.
pratica/16-trabalhar-numa-empresa/cenarios/

# Artefactos ocasionais de experiências (ver docs/12-exercicios.md, exercício A5).
*.tmp
.quiz-results.json
