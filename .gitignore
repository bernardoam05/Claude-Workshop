# Dependências instaladas: reconstroem-se a partir do package-lock.json / pom.xml / *.csproj.
node_modules/

# Saída de build: gerada, nunca escrita à mão.
dist/
build/
target/
bin/
obj/

# Segredos locais. O compose lê JWT_SECRET/WEB_PORT do ambiente; um .env nunca vai para o Git.
.env
.env.*
!.env.example

# Resultados de testes (Playwright) e logs.
test-results/
playwright-report/
blob-report/
*.log
npm-debug.log*

# Editores e sistema operativo.
.vscode/
.idea/
*.swp
.DS_Store

# Capturas de ecrã geradas pela prática de estilos (npm run verificar 09).
pratica/09-estilos-css/capturas/

# Repositórios Git de treino, criados por `npm run git-cenario` (módulo 16). Cada um tem o seu próprio .git.
pratica/16-trabalhar-numa-empresa/cenarios/

# Artefactos ocasionais de experiências (ver docs/12-exercicios.md, exercício A5).
*.tmp
.quiz-results.json

# Python (módulos 31, 34, 60, 61): o ambiente virtual reconstrói-se a partir de pratica/requirements.txt.
.venv/
__pycache__/
.pytest_cache/
*.pyc
db.sqlite3

# Terraform (módulo 33): providers descarregados e ESTADO. O estado pode conter segredos e
# nunca vai para o Git; numa equipa vive num "backend remoto" (ver o módulo 33, secção 6).
.terraform/
# (o .terraform.lock.hcl, pelo contrário, VAI para o Git: é o package-lock dos providers.)
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Ansible (módulo 34): coleções instaladas pelo ansible-galaxy e ficheiros temporários.
pratica/34-ansible/.colecoes/
*.retry

# Ferramentas descarregadas pela prática (ex.: o binário do Terraform, módulo 33).
pratica/.ferramentas/
# Ficheiros gerados pelo P1 do módulo 33 (o "recurso" que o Terraform cria).
pratica/33-terraform/p1-ficheiros/gerado/
