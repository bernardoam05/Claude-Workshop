<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven: gestor de build e dependências do mundo Java (o equivalente ao package.json + npm).
  O "parent" do Spring Boot fixa versões compatíveis de todas as bibliotecas: não escrevemos versões abaixo.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>pt.workshop</groupId>
  <artifactId>activity</artifactId>
  <version>1.0.0</version>
  <name>activity</name>
  <description>Serviço de atividade: consome eventos do Kafka e expõe um painel para administradores</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- "Starters": cada um traz um conjunto coerente de bibliotecas e a sua auto-configuração. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>          <!-- REST com Spring MVC + Tomcat embebido -->
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>     <!-- JPA/Hibernate (ORM) + Spring Data -->
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>  <!-- validar JWT do Keycloak -->
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>     <!-- health checks e métricas -->
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>                      <!-- consumidor/produtor Kafka -->
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>                       <!-- migrações de BD (o nosso migrate.js, em versão industrial) -->
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>   <!-- expõe /actuator/prometheus -->
      <scope>runtime</scope>
    </dependency>

    <!-- Testes: JUnit 5, Mockito, AssertJ, MockMvc vêm no starter-test. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>             <!-- simular utilizadores/JWT nos testes -->
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>        <!-- gera um JAR executável com tudo dentro -->
      </plugin>
    </plugins>
  </build>
</project>
