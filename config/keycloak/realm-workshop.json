{
  "realm": "workshop",
  "enabled": true,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "workshop-web",
      "name": "Frontend do workshop",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:8081/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "audience-workshop-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "workshop-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@workshop.local",
      "firstName": "Alice",
      "lastName": "Exemplo",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ],
      "id": "a11ce000-0000-4000-8000-000000000001"
    },
    {
      "id": "ca71a000-0000-4000-8000-000000000002",
      "username": "carla",
      "email": "carla@workshop.local",
      "firstName": "Carla",
      "lastName": "Admin",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "carla-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-workshop",
        "admin"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Acesso ao painel de atividade"
      }
    ]
  }
}
